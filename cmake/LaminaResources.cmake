include_guard(GLOBAL)

get_filename_component(_lamina_symbols_dir "${CMAKE_CURRENT_LIST_DIR}/../third_party/material-symbols" ABSOLUTE)
set(LAMINA_SYMBOLS_FONT "${_lamina_symbols_dir}/MaterialSymbolsRounded.woff2" CACHE FILEPATH "Material Symbols variable font that lamina_add_resources cuts icon fonts from")
set(LAMINA_SYMBOLS_CODEPOINTS "${_lamina_symbols_dir}/MaterialSymbolsRounded.codepoints" CACHE FILEPATH "Codepoints file naming the symbols of LAMINA_SYMBOLS_FONT")

set_property(GLOBAL PROPERTY LAMINA_CPP_KEYWORDS
    alignas alignof and and_eq asm auto bitand bitor bool break case catch char char8_t char16_t char32_t class compl
    concept const consteval constexpr constinit const_cast continue co_await co_return co_yield decltype default delete
    do double dynamic_cast else enum explicit export extern false float for friend goto if inline int long mutable
    namespace new noexcept not not_eq nullptr operator or or_eq private protected public register reinterpret_cast
    requires return short signed sizeof static static_assert static_cast struct switch template this thread_local throw
    true try typedef typeid typename union unsigned using virtual void volatile wchar_t while xor xor_eq)

function(lamina_icon_identifier out name)
    get_property(keywords GLOBAL PROPERTY LAMINA_CPP_KEYWORDS)
    if(name IN_LIST keywords)
        set(name "${name}_")
    elseif(name MATCHES "^[0-9]")
        set(name "_${name}")
    endif()
    set(${out} "${name}" PARENT_SCOPE)
endfunction()

function(lamina_icon_codepoints out caller)
    file(READ "${LAMINA_SYMBOLS_CODEPOINTS}" table)
    set(table "\n${table}")
    set(codes "")
    foreach(name IN LISTS ARGN)
        if(NOT name MATCHES "^[a-z0-9_]+$")
            message(FATAL_ERROR "${caller}: '${name}' is not a Material Symbols name (lower case letters, digits and _)")
        endif()
        if(NOT table MATCHES "\n${name} ([0-9a-f]+)")
            message(FATAL_ERROR "${caller}: no icon named '${name}' in ${LAMINA_SYMBOLS_CODEPOINTS}")
        endif()
        list(APPEND codes "${CMAKE_MATCH_1}")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${LAMINA_SYMBOLS_CODEPOINTS}")
    set(${out} "${codes}" PARENT_SCOPE)
endfunction()

function(_lamina_check_identifier caller what id)
    get_property(keywords GLOBAL PROPERTY LAMINA_CPP_KEYWORDS)
    if(NOT id MATCHES "^[A-Za-z_][A-Za-z0-9_]*$" OR id IN_LIST keywords)
        message(FATAL_ERROR "${caller}: ${what} '${id}' is not a C++ identifier")
    endif()
endfunction()

function(_lamina_write_if_changed path content)
    if(EXISTS "${path}")
        file(READ "${path}" old)
        if(old STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${content}")
endfunction()

function(lamina_write_resource_header path namespace)
    cmake_parse_arguments(PARSE_ARGV 2 arg "" "" "ICONS;CODES;FONTS;FILES")
    set(text "#pragma once\n\n")
    if(arg_ICONS)
        string(APPEND text "#include <array>\n\n#include \"lamina/icons/symbol.hpp\"\n")
    endif()
    if(arg_FONTS OR arg_FILES)
        string(APPEND text "#include \"lamina/resources/resource.hpp\"\n")
    endif()
    if(arg_ICONS)
        string(APPEND text "\nnamespace ${namespace}::icons {\n\n")
        set(all "")
        foreach(name code IN ZIP_LISTS arg_ICONS arg_CODES)
            lamina_icon_identifier(id "${name}")
            string(APPEND text "inline constexpr ::lamina::icons::Symbol ${id}{0x${code}};\n")
            string(APPEND all "    icons::${id},\n")
        endforeach()
        list(LENGTH arg_ICONS count)
        string(APPEND text "\n}\n\nnamespace ${namespace} {\n\ninline constexpr std::array<::lamina::icons::Symbol, ${count}> all_icons{\n${all}};\n\n}\n")
    endif()
    foreach(group IN ITEMS FONTS FILES)
        if(arg_${group})
            string(TOLOWER "${group}" lower)
            string(APPEND text "\nnamespace ${namespace}::${lower} {\n\n")
            foreach(id IN LISTS arg_${group})
                string(APPEND text "extern const ::lamina::resources::Resource ${id};\n")
            endforeach()
            string(APPEND text "\n}\n")
        endif()
    endforeach()
    get_filename_component(parent "${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    _lamina_write_if_changed("${path}" "${text}")
endfunction()

function(_lamina_embed out_source dir header namespace group id input)
    set(source "${dir}/${group}_${id}.cpp")
    add_custom_command(OUTPUT "${source}"
        COMMAND "${CMAKE_COMMAND}" "-DINPUT=${input}" "-DOUTPUT=${source}" "-DHEADER=${header}"
                "-DNAMESPACE=${namespace}::${group}" "-DID=${id}" -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/lamina_embed.cmake"
        DEPENDS "${input}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/lamina_embed.cmake"
        COMMENT "Embedding ${group}/${id}"
        VERBATIM)
    set(${out_source} "${source}" PARENT_SCOPE)
endfunction()

function(_lamina_resources_python out caller)
    set(Python3_FIND_REGISTRY LAST)
    find_package(Python3 COMPONENTS Interpreter)
    if(NOT Python3_Interpreter_FOUND)
        message(FATAL_ERROR "${caller}: cutting icon fonts needs Python 3 with fontTools and brotli (tools/icon-subset/requirements.txt); none was found. Set Python3_EXECUTABLE to one.")
    endif()
    if(NOT LAMINA_RESOURCES_PYTHON_CHECKED STREQUAL Python3_EXECUTABLE)
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B -I -c "import fontTools.subset, fontTools.varLib.instancer, brotli"
            RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${caller}: ${Python3_EXECUTABLE} cannot import fontTools and brotli, which cutting icon fonts needs. "
                "Install them with: \"${Python3_EXECUTABLE}\" -m pip install -r \"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/icon-subset/requirements.txt\"\n${error}")
        endif()
        set(LAMINA_RESOURCES_PYTHON_CHECKED "${Python3_EXECUTABLE}" CACHE INTERNAL "")
    endif()
    set(${out} "${Python3_EXECUTABLE}" PARENT_SCOPE)
endfunction()

function(lamina_add_resources name)
    set(caller "lamina_add_resources(${name})")
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "NAMESPACE;HEADER" "ICONS;ICON_FONTS;FILES")
    if(arg_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "${caller}: unknown arguments: ${arg_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT arg_NAMESPACE)
        set(arg_NAMESPACE "${name}")
    endif()
    if(NOT arg_HEADER)
        set(arg_HEADER "${name}.hpp")
    endif()
    if(arg_ICON_FONTS AND NOT arg_ICONS)
        message(FATAL_ERROR "${caller}: ICON_FONTS needs ICONS")
    endif()

    set(dir "${CMAKE_CURRENT_BINARY_DIR}/lamina_resources/${name}")
    set(include_dir "${dir}/include")
    set(sources "")
    set(font_ids "")
    set(file_ids "")
    set(icons "")
    set(codes "")

    if(arg_ICONS)
        get_property(builtin GLOBAL PROPERTY LAMINA_BUILTIN_ICONS)
        set(icons ${arg_ICONS} ${builtin})
        list(REMOVE_DUPLICATES icons)
        lamina_icon_codepoints(codes "${caller}" ${icons})
        if(NOT arg_ICON_FONTS)
            set(arg_ICON_FONTS symbols)
        endif()
        set(manifest "")
        set(cuts "")
        foreach(spec IN LISTS arg_ICON_FONTS)
            if(NOT spec MATCHES "^([^:]+)(:(.*))?$")
                message(FATAL_ERROR "${caller}: cannot read the icon font '${spec}'")
            endif()
            set(id "${CMAKE_MATCH_1}")
            set(axes "${CMAKE_MATCH_3}")
            _lamina_check_identifier("${caller}" "icon font" "${id}")
            if(id IN_LIST font_ids)
                message(FATAL_ERROR "${caller}: the icon font '${id}' is listed twice")
            endif()
            if(NOT axes STREQUAL "" AND NOT axes MATCHES "^[A-Za-z]+=-?[0-9.]+(,[A-Za-z]+=-?[0-9.]+)*$")
                message(FATAL_ERROR "${caller}: the axes of the icon font '${spec}' are not AXIS=value[,AXIS=value]")
            endif()
            string(REPLACE "," " " axes "${axes}")
            string(STRIP "font ${id} ${axes}" line)
            string(APPEND manifest "${line}\n")
            list(APPEND font_ids "${id}")
            list(APPEND cuts "${dir}/fonts/${id}.ttf")
        endforeach()
        foreach(code IN LISTS codes)
            string(APPEND manifest "icon ${code}\n")
        endforeach()
        file(MAKE_DIRECTORY "${dir}/fonts")
        _lamina_write_if_changed("${dir}/icons.txt" "${manifest}")
        _lamina_resources_python(python "${caller}")
        set(script "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/icon-subset/subset.py")
        add_custom_command(OUTPUT ${cuts}
            COMMAND "${python}" -B -I "${script}" "${LAMINA_SYMBOLS_FONT}" "${dir}/icons.txt" "${dir}/fonts"
            DEPENDS "${script}" "${LAMINA_SYMBOLS_FONT}" "${dir}/icons.txt"
            COMMENT "Cutting the icon fonts of ${name}"
            VERBATIM)
        foreach(id cut IN ZIP_LISTS font_ids cuts)
            _lamina_embed(source "${dir}" "${arg_HEADER}" "${arg_NAMESPACE}" fonts "${id}" "${cut}")
            list(APPEND sources "${source}")
        endforeach()
    endif()

    foreach(entry IN LISTS arg_FILES)
        if(NOT entry MATCHES "^([^=]+)=(.+)$")
            message(FATAL_ERROR "${caller}: FILES entries are <id>=<path>, not '${entry}'")
        endif()
        set(id "${CMAKE_MATCH_1}")
        get_filename_component(path "${CMAKE_MATCH_2}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        _lamina_check_identifier("${caller}" "file" "${id}")
        if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
            message(FATAL_ERROR "${caller}: the file '${id}' is not at ${path}")
        endif()
        if(id IN_LIST file_ids)
            message(FATAL_ERROR "${caller}: the file '${id}' is listed twice")
        endif()
        list(APPEND file_ids "${id}")
        _lamina_embed(source "${dir}" "${arg_HEADER}" "${arg_NAMESPACE}" files "${id}" "${path}")
        list(APPEND sources "${source}")
    endforeach()

    lamina_write_resource_header("${include_dir}/${arg_HEADER}" "${arg_NAMESPACE}"
        ICONS ${icons} CODES ${codes} FONTS ${font_ids} FILES ${file_ids})

    if(sources)
        add_library(${name} STATIC ${sources} "${include_dir}/${arg_HEADER}")
        target_include_directories(${name} PUBLIC "${include_dir}")
        target_link_libraries(${name} PUBLIC lamina)
    else()
        add_library(${name} INTERFACE)
        target_include_directories(${name} INTERFACE "${include_dir}")
        target_link_libraries(${name} INTERFACE lamina)
    endif()
endfunction()
