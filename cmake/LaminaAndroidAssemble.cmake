file(REMOVE_RECURSE "${STAGING}")
file(MAKE_DIRECTORY "${STAGING}/lib/${ABI}")
file(ARCHIVE_EXTRACT INPUT "${BASE_APK}" DESTINATION "${STAGING}")
file(COPY_FILE "${DEX}" "${STAGING}/classes.dex")
foreach(library IN LISTS LIBRARIES)
    get_filename_component(name "${library}" NAME)
    execute_process(COMMAND "${STRIP}" --strip-unneeded -o "${STAGING}/lib/${ABI}/${name}" "${library}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
file(GLOB_RECURSE entries RELATIVE "${STAGING}" "${STAGING}/*")
list(SORT entries)
list(JOIN entries "\n" listing)
file(WRITE "${OUTPUT}.entries" "${listing}\n")
file(REMOVE "${OUTPUT}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DOUTPUT=${OUTPUT}" "-DENTRIES=${OUTPUT}.entries" -P "${CMAKE_CURRENT_LIST_DIR}/LaminaAndroidZip.cmake"
    WORKING_DIRECTORY "${STAGING}" COMMAND_ERROR_IS_FATAL ANY)
